# Environment variables for the actions-runner watchdog / launchd installer
# (machine-specific paths; gitignored). Copy this template to .env and adjust.

# Runner install directory (where .runner / _diag live)
RUNNER_DIR=$HOME/actions-runner

# Log-idle minutes that, together with a missing :443 connection, mark the
# long-poll as dead. Deliberately generous: an idle-but-healthy runner goes
# hours without a log write, and it is the connection test that clears it.
RUNNER_WATCHDOG_STALE_MIN=60

# launchd agent labels (used for install / uninstall)
RUNNER_LAUNCHD_LABEL_RUNNER=dev.local.actions-runner
RUNNER_LAUNCHD_LABEL_WATCHDOG=dev.local.actions-runner-watchdog

# LaunchAgents directory
RUNNER_LAUNCHAGENTS_DIR=$HOME/Library/LaunchAgents
