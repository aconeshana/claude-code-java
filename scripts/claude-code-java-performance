#!/bin/sh
set -eu

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_jar="$launcher_dir/claude-code-app-0.1.0-SNAPSHOT.jar"
app_archive="$launcher_dir/claude-code-app-0.1.0-SNAPSHOT.jsa"

if [ ! -f "$app_jar" ]; then
  echo "Missing application JAR: $app_jar" >&2
  exit 1
fi

if [ -f "$app_archive" ]; then
  exec java -Xshare:auto -XX:SharedArchiveFile="$app_archive" \
    -XX:TieredStopAtLevel=3 -XX:+UseSerialGC -jar "$app_jar" "$@"
fi

exec java -XX:TieredStopAtLevel=3 -XX:+UseSerialGC -jar "$app_jar" "$@"
