<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Match the official client: debug logging is opt-in. In particular, the
      TUI emits high-volume key/stream diagnostics at DEBUG; running a
      synchronous DEBUG FileAppender by default serialized GUI input and token
      delivery on file I/O. CLAUDE_CODE_LOG_LEVEL=DEBUG remains available for
      diagnostics, but the async wrapper never blocks the producer thread.
    -->
    <property name="LOG_LEVEL" value="${CLAUDE_CODE_LOG_LEVEL:-INFO}"/>
    <!--
      The log file is append-mode and shared by every concurrently running CLI
      process, so lines must carry a pid to be attributable. The value is
      produced by a PropertyDefiner rather than System.setProperty, which would
      lose the race against the static Logger fields that initialise logback
      during entry-point class loading. No default value is supplied on purpose:
      a broken definer must render ccPid_IS_UNDEFINED instead of hiding behind a
      plausible-looking placeholder.
    -->
    <define name="ccPid" class="com.claudecode.app.ProcessIdPropertyDefiner"/>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>/tmp/claude-code-java.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [pid:${ccPid}] [%thread] %-5level %logger{30} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="ASYNC_FILE"/>
    </root>
</configuration>
